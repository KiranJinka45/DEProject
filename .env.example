# ==============================================================================
# ENVIRONMENT CONFIGURATION - E-COMMERCE MEDALLION ANALYTICS PLATFORM
# ==============================================================================

# Airflow Core Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3-python3.11
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=

# Metadata Database (PostgreSQL)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_secure_pass
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# Analytical Warehouse Database (PostgreSQL / Local Staging)
WAREHOUSE_USER=dw_admin
WAREHOUSE_PASSWORD=dw_secure_pass
WAREHOUSE_DB=ecommerce_warehouse
WAREHOUSE_HOST=postgres-warehouse
WAREHOUSE_PORT=5432

# MinIO / Local S3 Lakehouse
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_key
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secure_key
AWS_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1

# dbt Execution Configuration
DBT_PROFILES_DIR=/opt/airflow/dbt
DBT_PROJECT_DIR=/opt/airflow/dbt
